# Base URL of the orchestrator service that serves POST /chat.
# Local dev default (python -m app.main): http://localhost:8001
#
# NOTE: this is a BUILD-TIME variable — Vite bakes it into the static bundle at
# `npm run build`, so it can't be changed at deploy time without rebuilding the
# image. It must also be reachable from the browser (which runs outside the
# cluster), NOT an in-cluster DNS name like orchestrator-svc:8001. For an
# in-cluster deploy, set it to the orchestrator's NodePort URL
# (e.g. http://<minikube-ip>:30081) before building. Unlike dashboard-ui, this
# app's nginx has no /api proxy to rely on.
VITE_API_BASE_URL=http://localhost:8001