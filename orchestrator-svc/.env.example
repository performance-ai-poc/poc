# Copy this file to .env and adjust as needed. Never commit the real .env file.

APP_ENV=development
# 127.0.0.1 for local dev; the Dockerfile overrides this to 0.0.0.0 so the
# container is reachable from outside.
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO

# Placeholder for a future model provider API key. Unused today.
MODEL_API_KEY=

# ---------------------------------------------------------------------------
# REST API Agent (Agent 2) — LLM + MCP wiring.
#
# AGENT_LIVE_CALLS toggles the whole thing. Leave it false (the default) for
# tests / any environment without the LLM + MCP services running: the agent
# runs fully in-process and deterministic, and still emits the complete
# agent.* telemetry. Flip it true in a real demo once the MCP server (:8000)
# is up and the LLM endpoint is reachable.
AGENT_LIVE_CALLS=false

# OpenAI-compatible chat-completions endpoint used by the agent's planner.
LLM_BASE_URL=https://openai.rc.asu.edu/v1
LLM_API_KEY=
LLM_MODEL=qwen3-coder-30b-a3b-instruct
LLM_TIMEOUT_S=60

# streamable-http URL of the MCP server (mcp-server/app/server.py binds :8000).
MCP_SERVER_URL=http://localhost:8000/mcp
MCP_TIMEOUT_S=30

# Fallback tenant_id attached to requests that don't supply one, instead of
# a random UUID per request. Keep this stable across a demo/dev environment.
DEFAULT_TENANT_ID=default-tenant

# Comma-separated allowed CORS origins, or * for all (dev-friendly default).
# Tighten once the frontend's real origin is known, e.g.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=*
