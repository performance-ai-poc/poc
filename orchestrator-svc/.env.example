# Copy this file to .env and adjust as needed. Never commit the real .env file.

APP_ENV=development
# 127.0.0.1 for local dev; the Dockerfile overrides this to 0.0.0.0 so the
# container is reachable from outside.
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO

# Placeholder for a future model provider API key. Unused today.
MODEL_API_KEY=

# Fallback tenant_id attached to requests that don't supply one, instead of
# a random UUID per request. Keep this stable across a demo/dev environment.
DEFAULT_TENANT_ID=default-tenant

# Comma-separated allowed CORS origins, or * for all (dev-friendly default).
# Tighten once the frontend's real origin is known, e.g.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=*
