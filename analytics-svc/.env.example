# Copy to .env for local runs. All values have safe local defaults in
# app/config.py; override here for a real backend.

APP_ENV=development
HOST=0.0.0.0
PORT=8002
LOG_LEVEL=INFO

# Telemetry backend (OpenObserve) query API.
OPENOBSERVE_URL=http://localhost:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_STREAM=default
# Read-only Basic credential. Injected from a secret in deployment.
OPENOBSERVE_AUTH=Basic YWRtaW5AZXhhbXBsZS10ZXN0LmludmFsaWQ6b3RlbC1wb2MtbG9jYWwtb25seQ==

# Drift windows (minutes): live is the most recent window, baseline is the
# window immediately before it.
LIVE_WINDOW_MINUTES=15
BASELINE_WINDOW_MINUTES=60

CORS_ALLOWED_ORIGINS=*
